# ====================================================================
# GapMind environment variables (single source of truth, repo root)
#   - backend (uvicorn/celery/alembic): loaded by app.core.config
#   - infra (docker compose): docker compose --env-file ../.env up -d
#   - frontend (vite): VITE_* vars only, via envDir in vite.config.ts
# Copy to ".env" and fill in real keys.
# ====================================================================

# ---- App ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_STORAGE_DIR=./storage

# ---- PostgreSQL ----
POSTGRES_USER=gapmind
POSTGRES_PASSWORD=gapmind
POSTGRES_DB=gapmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gapmind:gapmind@localhost:5432/gapmind

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=gapmind_

# ---- LLM (Deepseek) ----
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional demo-day fuse: any OpenAI-compatible endpoint as backup; enabled
# only when all three fields below are set
DEEPSEEK_BACKUP_API_KEY=
DEEPSEEK_BACKUP_BASE_URL=
DEEPSEEK_BACKUP_MODEL=

# ---- Fine-tuned research-gap extractor (Ollama, zf model) ----
# Native backend: 127.0.0.1 (SSH tunnel). Docker backend: host.docker.internal.
GAP_EXTRACTOR_BASE_URL=http://127.0.0.1:11434
GAP_EXTRACTOR_MODEL=research-dataset-qwen3:run7-q8-templatefix
GAP_EXTRACTOR_MODEL_DIGEST=
GAP_EXTRACTOR_TIMEOUT_SECONDS=600
GAP_EXTRACTOR_REPAIR_ATTEMPTS=2
GAP_EXTRACTOR_NUM_CTX=32768
GAP_EXTRACTOR_NUM_PREDICT=4096
GAP_EXTRACTOR_TEMPERATURE=0.01
GAP_EXTRACTOR_TOP_P=1
GAP_EXTRACTOR_REPEAT_PENALTY=1.05
GAP_EXTRACTOR_SEED=42

# ---- Chat (workspace RAG) ----
CHAT_HISTORY_MESSAGE_LIMIT=20
CHAT_HISTORY_CHAR_LIMIT=60000
CHAT_MAX_INPUT_CHARS=12000
CHAT_RAG_TOP_K=6
CHAT_RAG_MAX_CONTEXT_CHARS=18000

# ---- Controlled workspace agents ----
AGENT_RAG_TOP_K=10
AGENT_CODE_MAX_FILES=30
AGENT_CODE_MAX_CHARS=300000

# ---- Embedding (SiliconFlow, BGE-m3) ----
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# ---- Semantic Scholar ----
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1

# ---- CORS (frontend origin) ----
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Frontend (vite only loads VITE_* vars; fallback matches dev proxy) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
