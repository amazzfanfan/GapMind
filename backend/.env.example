# Backend environment file. Copy from ../infra/.env.example and fill in real keys.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_STORAGE_DIR=./storage

POSTGRES_USER=gapmind
POSTGRES_PASSWORD=gapmind
POSTGRES_DB=gapmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gapmind:gapmind@localhost:5432/gapmind

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=gapmind_

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

CHAT_HISTORY_MESSAGE_LIMIT=20
CHAT_HISTORY_CHAR_LIMIT=60000
CHAT_MAX_INPUT_CHARS=12000
CHAT_RAG_TOP_K=6
CHAT_RAG_MAX_CONTEXT_CHARS=18000

# Workspace Agents. Code validation is intentionally disabled by default.
AGENT_RAG_TOP_K=10
AGENT_CODE_MAX_FILES=30
AGENT_CODE_MAX_CHARS=300000
AGENT_CODE_EXECUTION_ENABLED=false
AGENT_DOCKER_BINARY=docker
AGENT_SANDBOX_IMAGE=python:3.11-slim
AGENT_SANDBOX_TIMEOUT_SECONDS=60
AGENT_SANDBOX_MEMORY=512m
AGENT_SANDBOX_CPUS=1.0
AGENT_SANDBOX_PIDS=128

SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
