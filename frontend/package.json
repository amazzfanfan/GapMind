{
  "name": "gapmind-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "gen:api-types": "node -e \"require('fs').copyFileSync('../backend/openapi.json','openapi.json')\" && openapi-typescript ./openapi.json -o src/api/types/api.gen.ts",
    "gen:openapi": "cd ../backend && .venv\\Scripts\\python.exe scripts\\export_openapi.py",
    "gen:api": "npm run gen:openapi && npm run gen:api-types"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.21.0",
    "axios": "^1.7.7",
    "cytoscape": "^3.34.0",
    "katex": "^0.18.2",
    "react": "^18.3.1",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
